(defwidget image-list[]
    (box :class "scroll-container"
        :vexpand "true"
        :hexpand "false"
        :width 100
    (scroll :vscroll "true"
            :vexpand "true"
            (box :orientation "vertical"
                (for wallpaper in wallpapers
                    (eventbox :class "image-container"
                            :onclick "~/.config/eww/scripts/change-wallpaper.sh ${wallpaper}"
                            (box :class "image-list-preview"
                                :width 300;
                                :height 200;
                                :orientation "vertical"
                                :style "background-image: url('../../wallpapers/preview-${wallpaper}.jpg');")))))))

(defwidget win []
    (box :class "window"
        :vexpand "false"
        :hexpand "false"
        :orientation "vertical"
        (image-list)))


(defwindow wallpaper
    :monitor 0
    :geometry (geometry :x "10px"
                        :y "10px"
                        :width "20%"
                        :height "93%"
                        :anchor "center left")
    :stacking "overlay"
    :exclusive "false"
    :focusable "ondemand"
    (win)                    
)